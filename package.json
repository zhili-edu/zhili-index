{
  "name": "zhili-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && node scripts/emit-static-routes.mjs",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "oss": "ossutil sync -uf --delete ./out oss://zhili-index"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
